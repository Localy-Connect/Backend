# Spring Boot Service Auth
SPRING_APPLICATION_NAME=AuthService
SPRING_DATASOURCE_URL=jdbc:postgresql://auth_postgres:5432/authdb
SPRING_DATASOURCE_USERNAME=authuser
SPRING_DATASOURCE_PASSWORD=authsecret
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SERVER_PORT=8090
SPRING_SECURITY_USER_NAME=unused
SPRING_SECURITY_USER_PASSWORD=unused
JWT_SECRET=9o2vYvK9Zxq1r3Td5u6N8sV0wYfGhJkLmN4OpQrStUsdsa
JWT_EXPIRATION_MILLIS=3600000
MQTT_BROKER_URL=tcp://mqtt_broker:1883
MQTT_CLIENT_ID=auth-service-${RANDOM_VALUE}
MQTT_TOPIC_USER_UPDATE=user/update
